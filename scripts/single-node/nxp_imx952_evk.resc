using sysbus

$name?="nxp-imx952-evk"
mach create $name
machine LoadPlatformDescription @platforms/boards/nxp_imx952_evk.repl

# The Cortex-M7 is held in reset until released by the i.MX9 SiP auxiliary-core
# service, matching the normal heterogeneous boot flow.
m7 IsHalted true

# i.MX 9 auxiliary-core control is exposed to A-class software through the
# NXP SiP service at SMC function ID 0xC2000005. U-Boot's bootaux command
# uses x1 as the operation, x2 as the reset-vector address and x3 as core ID.
#
# Supported operations:
#   0 - MCU_START
#   1 - MCU_STARTED
#   2 - MCU_STOP
#   3 - MCU_RESET_ADDR_SET (accepted; START uses x2 directly)
#   4 - MCU_PREP
#   5 - MCU_PREPED
#
# Core ID 1 is Cortex-M7 on i.MX 952.
a55Cluster.a55_0 PSCIEmulationMethod SMC
a55Cluster.a55_0 AddCustomPSCIHandler 0xC2000005 """
from Antmicro.Renode.Core import EmulationManager
from Antmicro.Renode.Peripherals.CPU import RegisterValue

op = self.GetRegisterUlong(1)
address = self.GetRegisterUlong(2)
core_id = self.GetRegisterUlong(3)
result_code = 0

# ARMv8 custom PSCI handlers do not expose a direct Machine property on every
# Renode version. Resolve the i.MX 952 machine and M7 by name through the current
# emulation, matching the lookup used by the SCMI System Manager model.
machine = None
m7 = None
emulation = EmulationManager.Instance.CurrentEmulation
for candidate in emulation.Machines:
    lookup = emulation.TryGetEmulationElementByName("m7", candidate)
    if lookup[0]:
        machine = candidate
        m7 = lookup[1]
        break

if core_id != 1 or m7 is None or machine is None:
    result_code = 0xFFFFFFFFFFFFFFFF
elif op == 0: # MCU_START
    sp = machine.SystemBus.ReadDoubleWord(address)
    pc = machine.SystemBus.ReadDoubleWord(address + 4)
    if pc == 0:
        result_code = 0xFFFFFFFFFFFFFFFF
    else:
        m7.SP = RegisterValue.Create(sp, 32)
        m7.PC = RegisterValue.Create(pc & 0xFFFFFFFE, 32)
        m7.IsHalted = False
elif op == 1: # MCU_STARTED
    result_code = 0 if m7.IsHalted else 1
elif op == 2: # MCU_STOP
    m7.IsHalted = True
elif op == 3: # MCU_RESET_ADDR_SET
    # START receives the vector-table address directly in x2, matching the
    # U-Boot i.MX9 bootaux call sequence used by this platform model.
    result_code = 0
elif op == 4: # MCU_PREP
    result_code = 0
elif op == 5: # MCU_PREPED
    result_code = 1
else:
    result_code = 0xFFFFFFFFFFFFFFFF

self.SetRegisterUlong(0, result_code)
"""
